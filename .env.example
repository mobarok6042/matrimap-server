# ---------- Server ----------
NODE_ENV=development
PORT=4000

# ---------- MongoDB ----------
# Atlas SRV URI (recommended) or a direct replica-set URI.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.chtzce2.mongodb.net/
DB_NAME=matrimap
# Set to "true" for a replica set / sharded cluster (required for transactions).
MONGODB_ENABLE_TRANSACTIONS=true

# ---------- Better Auth ----------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Base URL of the Next.js app. Auth requests are proxied to this Express server.
BETTER_AUTH_URL=http://localhost:3000
# Browser origin allowed by CORS (comma-separated list also supported in app.ts).
CLIENT_URL=http://localhost:3000

# ---------- Google OAuth ----------
# Authorized redirect URI in Google Cloud:
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- ImgBB ----------
# Get a key at https://api.imgbb.com/
IMGBB_API_KEY=

# ---------- Stripe ----------
# Test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-to localhost:4000/api/payments/webhook`
STRIPE_WEBHOOK_SECRET=
# Legacy customer premium checkout amount, in cents. Vendor plan prices are
# configured server-side in src/lib/vendor-plan.ts.
STRIPE_SUCCESS_AMOUNT=999
