# ---------- Server ----------
NODE_ENV=development
PORT=4000

# ---------- MongoDB ----------
# Local standalone server by default. Use your Atlas SRV URI in production.
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=matrimap
# Set to "true" only for a replica set / sharded cluster (required for transactions).
MONGODB_ENABLE_TRANSACTIONS=false

# ---------- Better Auth ----------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Must be the URL of THIS server.
BETTER_AUTH_URL=http://localhost:4000
# The Next.js origin allowed by CORS (comma-separated list also supported in app.ts).
CLIENT_URL=http://localhost:3000

# ---------- ImgBB ----------
# Get a key at https://api.imgbb.com/
IMGBB_API_KEY=

# ---------- Stripe ----------
# Test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:4000/api/payments/webhook`
STRIPE_WEBHOOK_SECRET=
# Amount charged by the example checkout session, in cents.
STRIPE_SUCCESS_AMOUNT=999
